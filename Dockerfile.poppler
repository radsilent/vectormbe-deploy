# Layers the command-line tools VectorMBE shells out to onto the upstream image,
# none of which ship in radsilent/vectormbe:latest:
#
#   poppler-utils  -> pdftotext, for PDF spec import
#   git            -> version control push (/vc/push writes model.json, model.sysml,
#                     model.ttl, model.reqif, model.xmi into a work dir and runs
#                     git init/add/commit/push). Without it the endpoint fails with
#                     "git init: exec error: No such file or directory (os error 2)".
#   ca-certificates-> TLS trust store for pushing to https:// remotes; git cannot
#                     verify github.com without it.
#
# Rebuild after pulling a newer base image:
#   docker compose build --pull vectormbe && docker compose up -d vectormbe
FROM radsilent/vectormbe:latest
# The base image drops to the unprivileged `vectormbe` user, which cannot write
# /var/lib/apt (apt-get fails with "Permission denied", exit 100). Become root
# only for the install, then switch back — the app must NOT run as root.
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends poppler-utils git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
USER vectormbe
