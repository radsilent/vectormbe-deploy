# Caddy reverse proxy for VectorMBE
# Place your built UI files in ./www/ for static serving

:80 {
    # API proxy — long timeout for AI agent/chat and local-LLM model generation.
    # Design/model generation (POST /api/design/generate) on host Ollama + small
    # GPU takes ~90-150s and is variable; a 120s ceiling returned 504 empty body
    # and the UI showed "nothing generated". 300s lets slow-but-valid runs finish.
    handle_path /api/* {
        reverse_proxy vectormbe:8080 {
            transport http {
                response_header_timeout 300s
                read_timeout            300s
                write_timeout           300s
            }
        }
    }

    # Public model endpoint for the marketing-site chatbot (vectorstreamsystems.com).
    # That bot's backend is a Cloudflare Pages Function running on Cloudflare's edge,
    # so it cannot reach a private 127.0.0.1:11434 — a public route is the only way it
    # can talk to a local model. Kept deliberately narrow: ONLY `POST /ollama/api/chat`
    # is proxied. Every other verb and path under /ollama is refused below, so a
    # passer-by cannot hit /api/pull, /api/delete, /api/create or /api/push to evict
    # models and fill the disk, nor GET /api/tags to enumerate what this host runs.
    #
    # This block MUST stay above the static `handle` — those form a mutually-exclusive
    # first-match group, so anything below it would be rewritten to /index.html and the
    # bot would receive the SPA shell instead of JSON.
    # NOT authenticated, deliberately, and not an oversight to "fix" by adding the
    # matcher back without reading this. The site's backend is a Cloudflare Pages
    # Function, and this project cannot hold a Pages secret to send: Cloudflare
    # ignores dashboard environment variables — plaintext and encrypted alike — for a
    # Pages project that has a wrangler.toml, which that repo has. Measured
    # 2026-08-25. Turning the matcher on while the caller has no token 401s every
    # visitor; that happened once already.
    #
    # To enable it, the site repo has to be able to read CHAT_PROXY_TOKEN first (its
    # functions/api/chat.js explains how), and GET /api/chat must report
    # tokenConfigured true. Then restore:
    #     header X-Chat-Token {env.CHAT_PROXY_TOKEN}
    #     header_regexp X-Chat-Token ^.{32,}$
    # Both lines, not just the first: an absent env var adapts to an empty expected
    # value, and the exact match alone then admits an empty header — verified 200,
    # i.e. no auth at all. The length check is what makes it fail closed. Applying it
    # needs `docker compose up -d --force-recreate caddy`; a plain reload re-reads the
    # old bind-mounted inode and silently changes nothing.
    @ollama_chat {
        method POST
        path /ollama/api/chat
    }
    handle @ollama_chat {
        # Cap the prompt so the endpoint can't be farmed as a free long-context LLM.
        request_body {
            max_size 32KB
        }
        uri strip_prefix /ollama
        reverse_proxy vectormbe-ollama:11434 {
            transport http {
                # A cold model load on this GPU can take ~60s before the first token;
                # the site's own fetch gives up well before these ceilings.
                response_header_timeout 300s
                read_timeout            300s
                write_timeout           300s
            }
        }
    }

    # Liveness only. Ollama's root replies "Ollama is running" — enough for the site's
    # status dot to tell "model host is up" from "the box is off", without exposing
    # /api/tags and enumerating which models this host has.
    @ollama_health {
        method GET
        path /ollama/health
    }
    handle @ollama_health {
        uri replace /ollama/health /
        reverse_proxy vectormbe-ollama:11434
    }

    # Anything else under /ollama is not part of the public contract.
    handle /ollama/* {
        respond "Not found" 404
    }

    # Static UI files — MUST be inside a `handle` block. `handle` and `handle_path`
    # form a mutually-exclusive first-match group, so /api/* is proxied above and
    # never reaches this block. Without the wrapper, the top-level `try_files` runs
    # in the rewrite phase for ALL requests and rewrites /api/* to /index.html before
    # the proxy sees it — GET /api/* then returns index.html and POST /api/* returns
    # 405, so the agent (POST /api/agent/chat) fails and the UI looks dead.
    handle {
        root * /var/www/vectormbe
        try_files {path} {path}/ /index.html
        file_server
    }

    # Never cache the HTML shell or runtime config. If Cloudflare/browser serves a
    # stale env.runtime.js, the UI points at a dead API host and shows "No LLM" /
    # "API unreachable". Hashed assets under /assets/* stay cacheable (immutable).
    @nostore path / /index.html /env.runtime.js /sw.js /manifest.json
    header @nostore {
        Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0"
        Pragma "no-cache"
        Expires "0"
        Vary "Accept-Encoding"
    }

    encode gzip

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
