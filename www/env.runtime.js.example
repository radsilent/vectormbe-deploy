window.__VSS_ENV = window.__VSS_ENV || {};
// Public UI does not embed an API key by default. Demo users authenticate via
// the shared demo key handled by the login gate. Admin/Editor/Viewer keys stay
// in the server-side .env and are never bundled into the frontend.
window.__VSS_ENV.VECTORMBE_API_KEY = "";
// Use the same-origin relative path. Caddy proxies /api/* to the vectormbe
// container, so the UI needs no absolute API host. Do NOT point this at an
// absolute hostname: the retired vectorowl.* host no longer resolves, and a
// browser holding a cached copy of this file shows "API unreachable" / "No LLM".
// When changing this file, bump the ?v= on the env.runtime.js <script> tag in
// index.html — that is the only thing that reliably busts browser caches.
window.__VSS_ENV.VITE_VECTORMBE_API_URL = "/api";
