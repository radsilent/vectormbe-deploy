window.__VSS_ENV = window.__VSS_ENV || {};
// Public UI does not embed an API key by default. Demo users authenticate via
// the shared demo key handled by the login gate. Admin/Editor/Viewer keys stay
// in the server-side .env and are never bundled into the frontend.
window.__VSS_ENV.VECTORMBE_API_KEY = "";
// Points all production builds (nginx + Cloudflare Pages) at the live backend.
// Dev mode always uses the Vite proxy (/api) and ignores this value.
window.__VSS_ENV.VITE_VECTORMBE_API_URL = "https://vectorowl.vectorstreamsystems.com/api";
