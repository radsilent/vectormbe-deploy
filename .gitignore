.env
docker-compose.override.yml
# infra/hardware — never publish to this repo
enable-ollama-gpu.sh
harden-cloudflared.sh
docker-compose.override.yml
vectormbe.service
vectormbe-model-refresh.service
vectormbe-model-refresh.timer
models.conf
refresh-models.sh
switch-llm.sh
*.bak.*
# generated by refresh-models.sh — regenerated on each run, not source
available-models.txt
model-refresh.log
# runtime state bind-mounted into the vectormbe container: saved models,
# snapshots, and project files. Server data, not source — and this repo is
# public, so it must never be committed.
data/

# Stale compiled server binary under the old VectorOWL name. Build output;
# nothing in this repository references it.
vectorowld

# Written by scripts/deploy-ci.sh in the VectorMBE repo: the list of asset files
# the last deploy published, so the next one knows which generation to keep as the
# fallback for browsers still holding the previous index.html. Deploy state, not
# source, and it must not be committed — a stale copy would make a deploy prune the
# generation it was supposed to keep.
.assets-generation
