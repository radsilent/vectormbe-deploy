# ════════════════════════════════════════════════════════════════════
#  DEFAULT: everything runs LOCAL & FREE (no cloud calls, no API cost)
#  Both synthesis and embeddings use the local Ollama container.
# ════════════════════════════════════════════════════════════════════
VECTORMBE_LLM_PROVIDER=ollama
VECTORMBE_LLM_MODEL=qwen2.5
VECTORMBE_LLM_API_KEY=ollama-local

VECTORMBE_EMBEDDING_PROVIDER=ollama
VECTORMBE_EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=ollama

# Optional: Qdrant persistent vector store for production-scale ANN
# Uncomment the qdrant service in docker-compose.yml first, then set this.
# VECTORMBE_QDRANT_URL=http://qdrant:6333

# Optional: override default LLM endpoint (Ollama, Azure, etc.)
# VECTORMBE_LLM_ENDPOINT=http://ollama:11434/api/chat

# Multi-tenant isolation (demo/shared servers)
# Set to true so each API key gets its own isolated graph workspace.
VECTORMBE_ISOLATE_BY_SESSION=false

# Optional — shared secret for the public /ollama/api/chat route defined in the
# Caddyfile. Left unset, that one route answers 401 to everything and the rest of
# the stack is unaffected. To expose it, set >=32 random characters here and send
# the same value in an X-Chat-Token header; anything shorter is rejected.
# CHAT_PROXY_TOKEN=
